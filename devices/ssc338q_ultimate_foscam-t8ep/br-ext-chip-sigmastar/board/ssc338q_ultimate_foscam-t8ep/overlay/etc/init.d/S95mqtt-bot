#!/bin/sh
CONFIG=/etc/mqtt-bot.conf
PIDFILE=/var/run/mqtt-bot.pid
start() {
    [ -f "$CONFIG" ] || return 0
    command -v mqtt-bot >/dev/null 2>&1 || return 1
    . "$CONFIG"
    [ -n "${MQTT_HOST:-}" ] || return 0
    [ -n "${MQTT_USER:-}" ] || return 0
    [ -n "${MQTT_PASSWORD:-}" ] || return 0
    mqtt-bot \
        -h "$MQTT_HOST" -p "${MQTT_PORT:-1883}" \
        -u "$MQTT_USER" -P "$MQTT_PASSWORD" \
        -t 'foscam/t8ep/cmd' -r 'foscam/t8ep/response' -q 1 \
        -w ping:/usr/bin/foscam-control:ping \
        -w status:/usr/bin/foscam-control:status \
        -w uptime:/usr/bin/foscam-control:uptime \
        -w version:/usr/bin/foscam-control:version \
        -w memory:/usr/bin/foscam-control:memory \
        -w storage:/usr/bin/foscam-control:storage \
        -w network:/usr/bin/foscam-control:network \
        -w majestic_status:/usr/bin/foscam-control:majestic_status \
        -w mqtt_status:/usr/bin/foscam-control:mqtt_status \
        -w snapshot:/usr/bin/foscam-control:snapshot \
        -w audio_test:/usr/bin/foscam-control:audio_test \
        >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
}
stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
}
case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo 'Usage: S95mqtt-bot {start|stop|restart}' ;;
esac
